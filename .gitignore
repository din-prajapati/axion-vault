# ─── Obsidian System ─────────────────────────────────────────
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/cache
.obsidian/plugins/*/data.json     # user-specific plugin state
.obsidian/graph.json              # personal graph layout
.obsidian/starred.json
.obsidian/bookmarks.json
.obsidian/recent-files-obsidian.json

# Keep: app.json, appearance.json, hotkeys.json, community-plugins.json
# Keep: snippets/, themes/ (under .obsidian)
#
# Skipped below: Remix SVGs + plugin JS — restore with SETUP + icon scripts
# (see 99 - Meta/00 - Settings/COMMIT-GUIDE.md, SETUP-AND-GIT.md)

# ─── Skip on commit — reinstall / regenerate ─────────────────
# Remix Icon pack (Iconize): install-remix-icons.ps1 + fix + rename, or SETUP.sh step 4
.obsidian/icons/remix-icons/**/*.svg

# Icon archives / stray packs under .obsidian/icons
.obsidian/icons/**/*.zip
.obsidian/icons/boxicons/
.obsidian/icons/font-awesome-brands/
.obsidian/icons/font-awesome-solid/

# Community plugins: SETUP.ps1 / SETUP.sh / SETUP.bat (axion-plugins.json)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css

